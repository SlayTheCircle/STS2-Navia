; STS2-Navia 素材导入工程(Godot 4.5.1)。
; scripts/prep-art.sh 生成的源图放在 assets/STS2-Navia/ 下,经
; `godot --headless --path assets --import` 生成 .import 侧车与 .godot/imported/*.ctex,
; 再由 tools/pack_mod.gd 连同源图一起打入 pck(参考 Hikari pck 实证布局)。
config_version=5

[application]

config/name="STS2-Navia-Assets"
config/features=PackedStringArray("4.5")

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
